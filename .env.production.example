# Copy to .env.production, set real values, and keep it out of version control.
POSTGRES_DB=apexvoid
POSTGRES_USER=apexvoid
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
APEXVOID_PUBLIC_ORIGIN=https://crm.example.com
APEXVOID_BOOTSTRAP_ADMIN_EMAIL=administrator@example.com
APEXVOID_BOOTSTRAP_ADMIN_USERNAME=platform-admin
APEXVOID_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-bootstrap-password
FRONTEND_PORT=8080
# The production frontend is intended for a local TLS ingress/load balancer.
FRONTEND_BIND_ADDRESS=127.0.0.1
LOG_LEVEL=INFO
