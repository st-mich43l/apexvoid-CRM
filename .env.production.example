# Copy to .env.production, set real values, and keep it out of version control.
POSTGRES_DB=apexvoid
POSTGRES_USER=apexvoid
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
DATABASE_PROVISIONER_PASSWORD=replace-with-a-long-random-provisioner-password
DATABASE_PROVISIONING_URL=postgres://apexvoid_provisioner:replace-with-a-long-random-provisioner-password@postgres:5432/postgres?sslmode=disable
DATABASE_PROVISIONING_KEY=replace-with-a-stable-32-character-random-key
INTEGRATIONS_ASSERTION_SECRET=replace-with-a-32-character-random-secret
APEXVOID_APPS_NETWORK=apexvoid-apps
APEXVOID_DATA_NETWORK=apexvoid-data
APEXVOID_PUBLIC_ORIGIN=https://crm.example.com
APEXVOID_BOOTSTRAP_ADMIN_EMAIL=administrator@example.com
APEXVOID_BOOTSTRAP_ADMIN_USERNAME=platform-admin
APEXVOID_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-bootstrap-password
FRONTEND_PORT=8080
# The production frontend is intended for a local TLS ingress/load balancer.
FRONTEND_BIND_ADDRESS=127.0.0.1
LOG_LEVEL=INFO
