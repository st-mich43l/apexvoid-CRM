APP_ENV=development
APP_NAME=apexvoid-crm
SERVER_ADDRESS=:6868
DATABASE_URL=postgres://apexvoid:apexvoid@localhost:5432/apexvoid?sslmode=disable
# Optional, required only to approve external installations. This must use a
# dedicated PostgreSQL administrator connection; runtime traffic uses DATABASE_URL.
DATABASE_PROVISIONER_PASSWORD=change-me-to-a-long-random-secret
# Use the postgres service name when Enterprise runs in Docker.
DATABASE_PROVISIONING_URL=postgres://apexvoid_provisioner:change-me-to-a-long-random-secret@postgres:5432/postgres?sslmode=disable
# Stable, independent 32+ character random key encrypting app DB passwords at rest.
# Back it up securely: losing/changing it breaks incomplete-installation retries.
DATABASE_PROVISIONING_KEY=replace-with-a-stable-32-character-random-key
INTEGRATIONS_ASSERTION_SECRET=replace-with-a-32-character-random-secret
INTEGRATIONS_ALLOWED_SERVICE_HOSTS=cafe
APEXVOID_APPS_NETWORK=apexvoid-apps
APEXVOID_DATA_NETWORK=apexvoid-data
LOG_LEVEL=INFO
VITE_API_BASE_URL=http://localhost:6868
