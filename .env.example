APP_ENV=development
APP_NAME=apexvoid-crm
SERVER_ADDRESS=:6868
DATABASE_URL=postgres://apexvoid:apexvoid@localhost:5432/apexvoid?sslmode=disable
# Optional, required only to approve external installations. This must use a
# dedicated PostgreSQL administrator connection; runtime traffic uses DATABASE_URL.
DATABASE_PROVISIONING_URL=postgres://apexvoid_provisioner:change-me@localhost:5432/postgres?sslmode=disable
# Stable, independent 32+ character random key encrypting app DB passwords at rest.
# Back it up securely: losing/changing it breaks incomplete-installation retries.
DATABASE_PROVISIONING_KEY=replace-with-secure-random-secret-at-least-32-characters
LOG_LEVEL=INFO
VITE_API_BASE_URL=http://localhost:6868
